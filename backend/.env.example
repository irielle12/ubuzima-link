PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubuzima_link
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Generate a strong, unique value — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_secret_key_here

# Set to "production" on Render so the HTTPS-only redirect activates.
NODE_ENV=development
