PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubuzima_link
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Generate a strong, unique value — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=your_secret_key_here

# Set to "production" on Render so the HTTPS-only redirect activates.
NODE_ENV=development

# Africa's Talking — used to text patients their referral reference number.
# Leave unset to fall back to an `sms:` link the health worker sends manually.
# AT_USERNAME=your_at_username     (use "sandbox" for the free test account)
# AT_API_KEY=your_at_api_key
# AT_SENDER_ID=your_registered_sender_id   (optional — omit to use the default)
